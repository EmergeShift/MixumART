{
  "manifest_version": 3,
  "name": "Mixum Browser Bridge",
  "version": "1.0.0",
  "description": "Lets MixumART share user-approved cookies and tabs with a container browser. Values stay in memory and are never logged.",
  "minimum_chrome_version": "116",
  "permissions": ["cookies", "tabs", "tabGroups", "nativeMessaging", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Mixum Browser Bridge", "default_popup": "popup.html" },
  "key": ""
}
